{
  "name": "cogimon",
  "version": "0.1.0",
  "private": true,
  "description": "Cogimon: an AI creature companion adventure with offline exploration and an optional live model arena.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "lint": "npm --prefix client run lint",
    "check": "npm test && npm run lint && npm run build",
    "audit": "npm audit && npm --prefix client audit",
    "ping": "node server/scripts/ping.js",
    "battle": "node server/scripts/battle-cli.js",
    "install:all": "npm install && npm --prefix client install",
    "test": "node --test \"server/**/*.test.js\" \"shared/**/*.test.js\" \"client/*.test.js\" \"client/src/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.4.1",
    "openai": "^7.50.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "impeccable": "^4.8.0"
  }
}
